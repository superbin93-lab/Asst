# Copy this file to .env in the same folder as docker-compose.yml, then fill in
# real values. docker compose reads this file automatically.
#
#   cp .env.docker.example .env

# ---- Database (used by both the db and app containers) ----------------------
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---- Auth ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-32-byte-random-hex-string
SESSION_MAX_AGE_DAYS=7

# ---- App ------------------------------------------------------------------
# Public URL users will reach the app at. http://<vps-ip>:3000 for a quick
# test, or https://your-domain.tld once Cloudflare is in front.
APP_URL=http://localhost:3000
DEFAULT_LOCALE=vi
# Host port the app is published on (container always listens on 3000 inside).
APP_PORT=3000
# Interface the port is published on. Leave 0.0.0.0 to reach the app directly at
# http://<vps-ip>:3000. Set to 127.0.0.1 when Cloudflare Tunnel fronts the app,
# so nothing is exposed publicly.
APP_BIND=0.0.0.0

# ---- Cloudflare Tunnel (optional) -------------------------------------------
# Only needed for `docker compose --profile tunnel up -d`. Create the tunnel in
# Cloudflare Zero Trust > Networks > Tunnels, route its public hostname to
# http://app:3000, and paste the connector token here.
# TUNNEL_TOKEN=

# ---- First-boot seed --------------------------------------------------------
# Runs automatically when the app container starts (safe to re-run: it only
# upserts the admin account and reference data, it never wipes real data).
SEED_ON_START=true
# Set to true only if you want the bilingual demo employees/assets/tickets.
SEED_DEMO=false
SEED_ADMIN_EMAIL=admin@company.local
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
