# ---- Database ---------------------------------------------------------------
# Local dev uses the portable PostgreSQL under .devdb (npm run db:start).
DATABASE_URL="postgresql://itam:itam@localhost:55432/itam?schema=public"

# ---- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-32-byte-random-hex-string"
SESSION_MAX_AGE_DAYS="7"

# ---- App --------------------------------------------------------------------
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="vi"
