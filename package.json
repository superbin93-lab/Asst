{
  "name": "itam-suite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:poll": "next dev --webpack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "docker:db": "docker compose -f docker-compose.dev.yml up -d db",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f app",
    "docker:dev:stop": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:sh": "docker compose -f docker-compose.dev.yml exec app sh",
    "docker:dev:deps": "docker compose -f docker-compose.dev.yml down && docker volume rm -f itam-dev_node_modules itam-dev_next_cache && docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:reset": "docker compose -f docker-compose.dev.yml down -v",
    "docker:prod": "docker compose up -d --build",
    "db:start": "node scripts/devdb.mjs start",
    "db:stop": "node scripts/devdb.mjs stop",
    "db:status": "node scripts/devdb.mjs status",
    "db:psql": "node scripts/devdb.mjs psql",
    "db:reset": "node scripts/devdb.mjs reset",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "postinstall": "prisma generate",
    "check": "npm run typecheck && npm run lint && npm run i18n:check && npm test",
    "verify": "tsx scripts/verify-asset-flow.ts && tsx scripts/verify-leave-flow.ts",
    "shot": "tsx scripts/screenshot.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.1": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}
